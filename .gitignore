# ---------------------------------------------------------------------------
# Private project documentation
# Architecture, design notes, decision records and the ticket backlog live
# here and are NOT published with the code. Use `tk` to work with tickets.
# ---------------------------------------------------------------------------
Project_state/
.tickets/

# ---------------------------------------------------------------------------
# Personal agent tooling (Pantheon agent definitions). Not part of the product,
# and it names local infrastructure: model endpoints, pins and vendor quirks.
# The standing rules that matter to contributors live in AGENTS.md instead.
# ---------------------------------------------------------------------------
.pi/

# ---------------------------------------------------------------------------
# Runtime data: SQLite database, downloaded/copied sounds, custom icons,
# generated TTS cache. Never commit this - it is per-installation state.
# ---------------------------------------------------------------------------
/data/
# deploy/docker-compose.yml bind-mounts ./data from the deploy directory.
/deploy/data/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
/dist/
/build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# Integration fixtures
# Baked by the integration image and the board run; never committed.
# ---------------------------------------------------------------------------
/tests/fixtures/piper-voices/

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
node_modules/
.vite/
web/.svelte-kit/
# Playwright's per-run artifacts: traces, failure snapshots and the HTML report.
web/test-results/
web/playwright-report/
# The browser tier's screenshot evidence: a run output, regenerated by the suite.
web/browser/artifacts/
# The wheel carries the built UI at chime_deck/static via a hatch
# force-include from web/dist (pyproject.toml); that copy only ever exists
# inside a built wheel, so a hand-made one in the checkout must never be
# committed or picked up by the wheel target's `packages` walk.
src/chime_deck/static/
# NOTE: web/dist/ is intentionally NOT ignored - the built UI is shipped in
# the repo and in release artifacts so end users never need Node.js.

# ---------------------------------------------------------------------------
# Local secrets / overrides
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editors & OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
